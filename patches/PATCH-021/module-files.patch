+[pscustomobject]@{status=$(if ($running) {$state.status} else {'STOPPED'});phase=$(if ($running) {$state.phase} else {'stopped'});ramMiB=$state.ram_mib;androidBoot=($running -and $state.android_boot_completed);appAlive=($running -and $state.app_process_alive);health=$(if ($running) {$state.health} else {'STOPPED'});vmRunning=$running;vmPid=$state.pid;logs=$state.run_dir;updated=$state.updated_at} | ConvertTo-Json
diff --git a/android_control/Stop.ps1 b/android_control/Stop.ps1
new file mode 100644
--- /dev/null
+++ b/android_control/Stop.ps1
@@ -0,0 +1,23 @@
+$ErrorActionPreference = 'Stop'
+$statePath = Join-Path $PSScriptRoot 'state.json'
+if (-not (Test-Path -LiteralPath $statePath)) { Write-Output 'Not started'; exit 0 }
+$state = Get-Content -LiteralPath $statePath -Raw | ConvertFrom-Json
+$pythonPath = (Get-Content -LiteralPath (Join-Path $PSScriptRoot 'python-path.txt') -Raw).Trim()
+$entryPath = Join-Path $PSScriptRoot 'runtime.py'
+$runner = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + [int]$state.runner_pid)
+# Match this launcher's complete command, not merely a reused Python PID.
+$pythonPattern = [regex]::Escape($pythonPath)
+$entryPattern = [regex]::Escape($entryPath)
+$expectedCommand = '^\s*(?:"' + $pythonPattern + '"|' + $pythonPattern + ')\s+-X\s+utf8\s+-B\s+(?:"' + $entryPattern + '"|' + $entryPattern + ')\s*$'
+$ownRunner = $runner -and $runner.ExecutablePath -eq $pythonPath -and $runner.CommandLine -match $expectedCommand
+if (-not $ownRunner) {
+    $vm = Get-Process -Id ([int]$state.pid) -ErrorAction SilentlyContinue
+    if ($vm -and $vm.Path -eq (Join-Path $PSScriptRoot 'qemu\qemu-system-x86_64.exe')) {
+        Write-Error 'orphan_vm: Android is still running, but its verified controller is unavailable. No process was terminated.' -ErrorAction Continue
+        exit 2
+    }
+    Write-Output 'Not running'
+    exit 0
+}
+[System.IO.File]::WriteAllText((Join-Path $PSScriptRoot 'stop.request'), [DateTimeOffset]::Now.ToString('o'))
+Write-Output 'Graceful shutdown requested. Check Status.ps1.'
diff --git a/android_control/Window.ps1 b/android_control/Window.ps1
new file mode 100644
--- /dev/null
+++ b/android_control/Window.ps1
@@ -0,0 +1,27 @@
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Windows.Forms
+Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+public static class AndroidPlacement {
+    [DllImport("user32.dll")] public static extern bool SetWindowPos(IntPtr hwnd, IntPtr after, int x, int y, int width, int height, uint flags);
+}
+'@
+$state = Get-Content -LiteralPath (Join-Path $PSScriptRoot 'state.json') -Raw | ConvertFrom-Json
+$size = '960x600'
+$configPath = Join-Path $PSScriptRoot 'control-settings.json'
+if(Test-Path -LiteralPath $configPath) { $size = (Get-Content -LiteralPath $configPath -Raw | ConvertFrom-Json).size }
+if($size -notin @('800x500','960x600','1280x800')) { throw 'Unsupported window size' }
+$dimensions = $size.Split('x')
+$area = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
+$width = [Math]::Min([int]$dimensions[0], $area.Width - 40)
+$height = [Math]::Min([int]$dimensions[1] + 32, $area.Height - 40)
+for($attempt=0; $attempt -lt 40; $attempt++) {
+    $vm = Get-Process -Id $state.pid -ErrorAction SilentlyContinue
+    if(-not $vm -or $vm.Path -ne (Join-Path $PSScriptRoot 'qemu\qemu-system-x86_64.exe')) { exit 0 }
+    if($vm.MainWindowHandle -ne [IntPtr]::Zero) {
+        [AndroidPlacement]::SetWindowPos($vm.MainWindowHandle, [IntPtr]::Zero, ($area.Right-$width-20), ($area.Top+20), $width, $height, 0x14) | Out-Null
+        exit 0
+    }
+    Start-Sleep -Milliseconds 200
+}
